# Loads the ssh key into the session agent at login, passphrase from the login
# keyring, so nothing downstream has to ask -- including whatever has no tty.

[Unit]
Description=Load the ssh key into the session agent
Documentation=man:ssh-add(1) man:secret-tool(1)
Requires=ssh-agent.socket
After=ssh-agent.socket dbus.socket
ConditionPathExists=%h/.ssh/id_ed25519

[Service]
Type=oneshot
RemainAfterExit=yes
# Otherwise the helper's stderr is tagged `sh` and `journalctl -u` hides it.
SyslogIdentifier=ssh-add-key

Environment=SSH_AUTH_SOCK=%t/ssh-agent.socket

# Scoped to this unit: session-wide, the helper would answer every unrelated
# password prompt with silence. force because ssh-add otherwise wants $DISPLAY,
# which is not set at default.target time.
Environment=SSH_ASKPASS=%h/.ssh/askpass-keyring
Environment=SSH_ASKPASS_REQUIRE=force

# Retried: the keyring unlock and this manager start from the same login,
# unordered.
ExecStart=/bin/sh -c 'for try in 1 2 3; do ssh-add %h/.ssh/id_ed25519 && exit 0; sleep 2; done; exit 1'

[Install]
# Not graphical-session.target: systemd asks that units not enable into it.
WantedBy=default.target
