# Terminal chrome only, matching the greyscale desktop. The 16 ANSI colours
# stay at ghostty's defaults, which every TUI depends on.
#
# Check edits with `ghostty +validate-config`.

background = 232326
foreground = d8d8d8

cursor-style = block
selection-background = 2e2e2e
selection-foreground = d8d8d8

# Mono forces every glyph, icons included, into one cell, which is what keeps
# TUI columns aligned; plain "Hack Nerd Font" misaligns lazygit.
font-family = Hack Nerd Font Mono
font-size = 9

# Otherwise the GTK4 frontend draws its own headerbar. Enum, not a boolean.
window-decoration = none

# balance = false sends the sub-cell remainder of sway's window size to the
# right and bottom edges rather than splitting it across opposite ones.
window-padding-x = 0
window-padding-y = 0
window-padding-balance = false

# No "close this terminal?" dialog on quit; ghostty otherwise prompts whenever
# shell integration thinks a process is still running.
confirm-close-surface = false

# Alt+1..9 belongs to tmux's window switching, so ghostty must not eat it for
# its own tabs. Both spellings are bound by default: the logical key and the
# physical one.
keybind = alt+1=unbind
keybind = alt+2=unbind
keybind = alt+3=unbind
keybind = alt+4=unbind
keybind = alt+5=unbind
keybind = alt+6=unbind
keybind = alt+7=unbind
keybind = alt+8=unbind
keybind = alt+9=unbind
keybind = alt+digit_1=unbind
keybind = alt+digit_2=unbind
keybind = alt+digit_3=unbind
keybind = alt+digit_4=unbind
keybind = alt+digit_5=unbind
keybind = alt+digit_6=unbind
keybind = alt+digit_7=unbind
keybind = alt+digit_8=unbind
keybind = alt+digit_9=unbind
