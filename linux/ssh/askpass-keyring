#!/usr/bin/sh
# SSH_ASKPASS helper: prints a key passphrase from the login keyring. ssh-add
# takes one from a tty or an askpass program, never stdin, so automating it
# needs a program. Only ssh-add-key.service points SSH_ASKPASS here.
#
# Keyed on the basename, not the path: $HOME is /home/... for a shell and
# /var/home/... for systemd, and keyring attributes match as strings.
set -eu

key_name="${SSH_ASKPASS_KEY_NAME:-id_ed25519}"

if ! command -v secret-tool >/dev/null 2>&1; then
    echo "askpass-keyring: secret-tool not installed" >&2
    exit 1
fi

if ! secret_out="$(secret-tool lookup dotfiles ssh-passphrase key "$key_name")" ||
        [ -z "$secret_out" ]; then
    echo "askpass-keyring: no keyring entry for key '$key_name'" >&2
    exit 1
fi

# printf, not echo: a trailing newline is not the stored passphrase.
printf '%s' "$secret_out"
